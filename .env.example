# All optional. Nothing here is a paid service.
OLLAMA_URL=http://localhost:11434
BOOKREADER_DATA_DIR=./data
# Optional local Piper TTS HTTP server (e.g. piper-http / wyoming bridge) returning audio/wav for POST {text, voice}
PIPER_URL=
# Max upload size in MB
MAX_UPLOAD_MB=500

# Optional: local Unlimited-OCR (github.com/baidu/Unlimited-OCR) served with SGLang; needs an NVIDIA GPU. When set, the reader's OCR button uses it instead of Tesseract.
UNLIMITED_OCR_URL=
# UNLIMITED_OCR_MODEL=Unlimited-OCR-2
# UNLIMITED_OCR_PROMPT=<image>
Multi page parsing.
